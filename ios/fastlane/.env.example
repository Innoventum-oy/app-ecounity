# Copy to ios/fastlane/.env and fill in local values.
#
# Preferred: App Store Connect API key. Use either a fastlane JSON key file:
# APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/app-store-connect-api-key.json
#
# Or p8 key components:
# APP_STORE_CONNECT_API_KEY_KEY_ID=
# APP_STORE_CONNECT_API_KEY_ISSUER_ID=
# APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# APP_STORE_CONNECT_API_KEY_DURATION=500
# APP_STORE_CONNECT_API_KEY_IN_HOUSE=false
#
# CI alternative: store the raw or base64-encoded .p8 content in an env var.
# APP_STORE_CONNECT_API_KEY_KEY=
# APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64=true

# Optional fallback for Apple ID authentication.
# APP_STORE_CONNECT_USERNAME=person@example.com
# APP_STORE_CONNECT_TEAM_ID=
# APP_STORE_CONNECT_TEAM_NAME=
# APP_STORE_CONNECT_ITC_PROVIDER=

# Optional: choose iOS screenshot targets.
# Defaults auto-create App Store Connect-compatible simulators:
# - iphone_65: Ecounity iPhone 6.5 from iPhone 11 Pro Max, 1242x2688
# - ipad_13: Ecounity iPad 13 from iPad Pro 13-inch (M4), 2064x2752
SCREENSHOT_TARGETS=iphone_65,ipad_13
SCREENSHOT_DRIVE_RETRIES=1
SCREENSHOT_UPLOAD_RETRIES=2
SCREENSHOT_UPLOAD_RETRY_DELAY=90
DELIVER_NUMBER_OF_THREADS=1
FL_NUMBER_OF_THREADS=1
SPACESHIP_SCREENSHOT_UPLOAD_TIMEOUT=3

# Optional: let fastlane create/download Apple Distribution signing assets
# before exporting an App Store IPA.
DEVELOPMENT_TEAM_ID=6GB259Z94P
APP_STORE_PROFILE_NAME=Ecounity App Store
# IOS_SETUP_SIGNING=false
# IOS_EXPORT_OPTIONS_PLIST=/absolute/path/to/ExportOptions.plist

# Optional: bypass auto-created simulators with existing simulator names or UDIDs.
# SCREENSHOT_IPHONE_DEVICE=
# SCREENSHOT_IPAD_DEVICE=
# Legacy shortcut used as the iPhone target when SCREENSHOT_IPHONE_DEVICE is not set.
# SCREENSHOT_DEVICE=
SCREENSHOT_LOCALES=en,de,es,fi,it,pl,pt,ro,uk

# Optional: restrict App Store metadata validation/upload to selected locales.
# Defaults to every app language under ios/fastlane/metadata/ios.
APP_STORE_METADATA_LOCALES=en-GB,de-DE,es-ES,fi,it,pl,pt-PT,ro,uk
