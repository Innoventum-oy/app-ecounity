# Copy to android/fastlane/.env and fill in local values.
#
# Fastlane can use either a service-account JSON file path or the raw JSON
# content. Relative JSON paths are resolved from the android/ folder. Keep both
# out of git.
GOOGLE_PLAY_JSON_KEY_FILE=fastlane/google-play-service-account.json
# GOOGLE_PLAY_JSON_KEY_DATA={"type":"service_account",...}

# Optional Android release build configuration.
ANDROID_PACKAGE_NAME=app.ecounity.ecounity
ANDROID_KEY_PROPERTIES=android/key.properties
ANDROID_RELEASE_AAB=build/app/outputs/bundle/release/app-release.aab
# ANDROID_ALLOW_DEBUG_SIGNING=false
ANDROID_SDK_ROOT=/Users/jleinone/Library/Android/sdk

# Optional: choose Android screenshot targets for Google Play.
# phone -> phoneScreenshots
# seven_inch -> sevenInchScreenshots
# ten_inch -> tenInchScreenshots
SCREENSHOT_TARGETS=phone,seven_inch,ten_inch
SCREENSHOT_PHONE_AVD=Pixel_6_API_33
SCREENSHOT_SEVEN_INCH_AVD=Ecounity_7in_API_33
SCREENSHOT_TEN_INCH_AVD=Ecounity_10in_API_33
SCREENSHOT_DRIVE_RETRIES=1
SCREENSHOT_DRIVE_TIMEOUT=600
# If flutter drive exits non-zero after this many screenshots were written,
# Fastlane keeps the completed locale/device batch and continues.
SCREENSHOT_MINIMUM_COUNT=10
# Preserve build/fastlane/raw/android and skip completed target-locale batches.
# SCREENSHOT_RESUME=false

# Optional: bypass AVD auto-launch with already running emulator/device ids.
# Example: emulator-5554
# SCREENSHOT_PHONE_DEVICE=
# SCREENSHOT_SEVEN_INCH_DEVICE=
# SCREENSHOT_TEN_INCH_DEVICE=
# Legacy shortcut used as the phone target when SCREENSHOT_PHONE_DEVICE is not set.
# SCREENSHOT_DEVICE=
SCREENSHOT_LOCALES=en,de,es,fi,it,pl,pt,ro,uk
# Optional: restrict Google Play screenshot upload to prepared Play locales.
# Defaults to every locale with screenshots under android/fastlane/metadata/android.
# SCREENSHOT_UPLOAD_LOCALES=en-GB

# Optional: Google Play listing text locales under
# android/fastlane/metadata/android/<locale>/.
PLAY_METADATA_LOCALES=en-GB,de-DE,es-ES,fi-FI,it-IT,pl-PL,pt-PT,ro-RO,uk
# Optional: restrict `check_store_listing_assets` image types.
# PLAY_IMAGE_TYPES=icon,featureGraphic,phoneScreenshots,sevenInchScreenshots,tenInchScreenshots
